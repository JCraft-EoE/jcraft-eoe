{
  "schemaVersion": 1,
  "id": "jcraft",
  "version": "${version}",

  "name": "JCraft",
  "description": "so yeah i wanted to add jojo stands to mc",
  "authors": [
    "Arna",
    "PlanetTeamSpeak",
    "MrSterner"
  ],

  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/Arna577/jcraft-eoe/"
  },

  "accessWidener" : "jcraft.accesswidener",

  "license": "MIT",
  "icon": "assets/jcraft/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.arna.jcraft.JCraft"
    ],
    "client": [
      "net.arna.jcraft.client.JCraftClient"
    ],
    "fabric-datagen": [
      "net.arna.jcraft.datagen.JDataGen"
    ],
    "cardinal-components": [
      "net.arna.jcraft.common.component.JComponents"
    ],
    "modmenu": [
      "net.arna.jcraft.client.JModMenuIntegration"
    ]
  },

  "mixins": [
    "jcraft.mixins.json",
    {
      "environment": "client",
      "config": "jcraft.client.mixins.json"
    },
    "jgravity.mixins.json",
    {
      "environment": "client",
      "config": "jgravity.client.mixins.json"
    }
  ],

  "suggests": {
    "bettercombat": "*",
    "rebind_narrator": "fabric-1.19.2"
  },

  "depends": {
    "fabricloader": ">=0.14.14",
    "fabric": "*",
    "minecraft": "~1.19.2",
    "java": ">=17",
    "player-animator": ">=0.3",
    "cardinal-components-base": "*",
    "cardinal-components-entity": "*",
    "cardinal-components-world": "*",
    "cloth-config": "*"
  },

  "custom": {
    "cardinal-components": [
      "jcraft:gravity_direction",
      "jcraft:stand",
      "jcraft:spec",
      "jcraft:ph",
      "jcraft:cooldowns",
      "jcraft:time_stop",
      "jcraft:misc",
      "jcraft:bomb_tracker",
      "jcraft:grab",
      "jcraft:hit_property",
      "jcraft:shockwave_handler",
      "jcraft:gravity_shift",
      "jcraft:vampire"
    ]
  }
}
