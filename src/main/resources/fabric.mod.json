{
  "schemaVersion": 1,
  "id": "jcraft",
  "version": "${version}",

  "name": "JCraft",
  "description": "so yeah i wanted to add jojo stands to mc",
  "authors": [
    "Arna"
  ],

  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },

  "accessWidener" : "jcraft.accesswidener",

  "license": "MIT",
  "icon": "assets/jcraft/icon.png",

  "environment": "*",
